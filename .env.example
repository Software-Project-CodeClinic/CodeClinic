# .env.example — 이 파일을 복사해 .env를 만들고 실제 값을 채워 넣으세요
# cp .env.example .env

# TimescaleDB
POSTGRES_DB=waf
POSTGRES_USER=waf
POSTGRES_PASSWORD=waf_local_secret   # 로컬 개발용. 운영 환경에서는 반드시 변경

# Spring Gateway DB 연결 (docker compose 외부에서 앱 직접 실행 시)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=waf
DB_USER=waf
DB_PASSWORD=waf_local_secret

# AI 서버 URL (로컬: http://localhost:8000, 컨테이너: http://fastapi:8000)
AI_SERVER_URL=http://localhost:8000

# Semgrep 실행 경로 (PATH에 semgrep이 없는 경우 명시적으로 지정)
# Windows (pip install semgrep):
#   SEMGREP_CMD=C:\Users\{username}\AppData\Roaming\Python\Python3XX\Scripts\pysemgrep.exe
# Linux/Mac (venv):
#   SEMGREP_CMD=/path/to/.venv/bin/semgrep
# PATH에 semgrep이 있으면 비워두면 됨
SEMGREP_CMD=
